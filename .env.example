# Copier ce fichier en ".env" pour tester Supabase en local (ne jamais le mettre sur GitHub)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=colle-ici-la-cle-service_role
ADMIN_USER=admin
ADMIN_PASSWORD=un-mot-de-passe-solide
SESSION_SECRET=une-longue-phrase-secrete
# Bot Telegram (BotFather) + ID du groupe de l'équipe (taper /id au bot dans le groupe)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Facultatif : réponses intelligentes du bot (clé gratuite sur console.groq.com)
GROQ_API_KEY=
